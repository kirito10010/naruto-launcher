{
  "name": "naruto-online-launcher",
  "version": "2.3.0",
  "description": "火影忍者Online页游启动器",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:server": "electron-builder --projectDir server-app -w zip"
  },
  "keywords": [
    "naruto",
    "flash",
    "game",
    "launcher"
  ],
  "author": "lijin <a3025863517@163.com>",
  "license": "ISC",
  "devDependencies": {
    "electron": "^11.5.0",
    "electron-builder": "^22.14.13"
  },
  "build": {
    "appId": "com.example.naruto-launcher",
    "productName": "NarutoOnlineLauncher",
    "directories": {
      "output": "release-v2.3.0"
    },
    "icon": "resources/icons/Naruto.png",
    "files": [
      "main.js",
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/flash/",
        "to": "flash"
      },
      {
        "from": "resources/native/",
        "to": "native"
      },
      {
        "from": "resources/icons/",
        "to": "icons"
      },
      {
        "from": "resources/videos/",
        "to": "videos"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kirito10010",
        "repo": "naruto-launcher"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
